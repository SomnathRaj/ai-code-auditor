# Copy to .env and fill in. Never commit .env.
FLASK_DEBUG=1
# Dev server address (used by `flask run` and `python run.py`)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=4000

# Signs access tokens. At least 32 characters.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# MongoDB (runs in its own Docker container, port 27017 published to the host).
# A replica set (add &replicaSet=rs0) enables transactions; standalone also works.
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin
MONGODB_DATABASE=ai_code_auditor

# Optional: enables the pytest suite. Tests create and drop their own
# aca_test_* databases on this server; they never touch MONGODB_DATABASE.
# TEST_MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin

# Encrypts GitHub access tokens and uploaded source archives at rest.
# Comma-separated; the first key encrypts, all keys decrypt (for rotation).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=change-me

# Source acquisition limits and scratch space (per-audit directories, mode 0700)
MAX_UPLOAD_MB=100
MAX_SOURCE_MB=500
MAX_SOURCE_FILES=50000
GIT_CLONE_TIMEOUT=300
# WORK_DIR=/var/lib/ai-code-auditor/work   (default: system temp dir)

# Scanner engine (Sprint 3). Install tools with scripts/install-scanners.sh.
# SCANNER_USER=scanner        # required if the app runs as root: scanners drop to this user
# SEMGREP_JOBS=4
# SEMGREP_TIMEOUT=900
# SEMGREP_EXTRA_CONFIGS=      # e.g. p/default — Semgrep Registry rules; review their licence first
# OSV_ENABLED=1               # dependency advisories from api.osv.dev (only names+versions are sent)

# AI analysis (Sprint 5): Google Gemini. Without a key the AI stage is skipped and no code is sent.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash      # or gemini-3.5-flash-lite (cheaper)
AI_MIN_SEVERITY=medium             # only findings at or above this are analysed
AI_MAX_FINDINGS=50                 # per audit
# AI_CONCURRENCY=4
# AI_REQUESTS_PER_MINUTE=0         # 0 = learn from Gemini's 429s (free tier: 15)
# AI_ENABLED=1                     # 0 turns AI off server-wide
# GEMINI_BASE_URL=                 # optional egress proxy

# Audit worker (Sprint 4): embedded (inside the web process) | external (`flask --app run worker`) | off
AUDIT_WORKER=embedded
WORKER_CONCURRENCY=2
AUDIT_TIMEOUT_SECONDS=3600
# WORKER_STALE_SECONDS=120    # a running audit without heartbeat for this long is re-queued
# AUDIT_MAX_ATTEMPTS=2

# Set to 1 when served over HTTPS (marks the refresh cookie Secure)
COOKIE_SECURE=0

# Extra origins allowed to use the refresh cookie / call the API cross-origin,
# comma-separated (e.g. https://app.example.com). Empty = same origin only.
ALLOWED_ORIGINS=

# Let Flask serve frontend/ (development). In production Nginx serves it.
SERVE_FRONTEND=1

# Set to 1 behind a reverse proxy (Nginx) so scheme/host/IP come from X-Forwarded-*
PROXY_FIX=0

# ---- Security & hardening (Sprint 8) ----
# Rate limits (counters in MongoDB, shared by all gunicorn workers). Keep enabled in production.
RATE_LIMIT_ENABLED=1
# Activity-log entries older than this are deleted by the daily retention job (0 = keep forever)
AUDIT_LOG_RETENTION_DAYS=365
# SCANNER_USER=                 # run scanners as this (egress-restricted) user; required if the app runs as root
# WORK_DIR=/var/lib/aca/work    # audit workspaces (0700, owned by the app user); default: system temp dir

# Production (see docs/DEPLOYMENT.md): FLASK_DEBUG=0, COOKIE_SECURE=1, PROXY_FIX=1, SERVE_FRONTEND=0,
# AUDIT_WORKER=external, ALLOWED_ORIGINS=https://your-host, and gunicorn -c gunicorn.conf.py run:app
